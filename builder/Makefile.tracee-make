#
# DEPRECATED: the containerized build environment is now driven by the main
# Makefile, which dispatches every target into it by default. This shim
# forwards the old target names and will be removed in a future release.
#
#   alpine-prepare        ->  make image DISTRO=alpine
#   ubuntu-prepare        ->  make image DISTRO=ubuntu
#   alpine-shell          ->  make shell DISTRO=alpine
#   ubuntu-shell          ->  make shell DISTRO=ubuntu
#   alpine-make ARG="x"   ->  make x DISTRO=alpine
#   ubuntu-make ARG="x"   ->  make x DISTRO=ubuntu
#

MAKEFLAGS += --no-print-directory

ARG ?=

define deprecated
	@echo "DEPRECATED: use '$(1)' instead" >&2
	@$(1)
endef

.PHONY: all help
all help:
	@echo "DEPRECATED: the build environment is driven by the main Makefile now:"
	@echo ""
	@echo "    $$ make [target...]                # runs in the container by default"
	@echo "    $$ make image DISTRO=alpine|ubuntu # (re)build the build environment image"
	@echo "    $$ make shell DISTRO=alpine|ubuntu # interactive shell in the build environment"
	@echo ""

.PHONY: alpine-prepare ubuntu-prepare alpine-shell ubuntu-shell alpine-make ubuntu-make
alpine-prepare:
	$(call deprecated,make image DISTRO=alpine)
ubuntu-prepare:
	$(call deprecated,make image DISTRO=ubuntu)
alpine-shell:
	$(call deprecated,make shell DISTRO=alpine)
ubuntu-shell:
	$(call deprecated,make shell DISTRO=ubuntu)
alpine-make:
	$(call deprecated,make $(ARG) DISTRO=alpine)
ubuntu-make:
	$(call deprecated,make $(ARG) DISTRO=ubuntu)

.PHONY: clean
clean:
	@make clean
